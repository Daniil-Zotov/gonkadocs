{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "gonka-docs": {
      "type": "local",
      "command": ["python3", "buildtools/mcp-server.py"],
      "enabled": true
    }
  },
  "command": {
    "build": {
      "description": "Build the full site (both MkDocs builds) into _site/",
      "template": "bash buildtools/build.sh"
    },
    "serve": {
      "description": "Build and serve locally on port 8000",
      "template": "bash buildtools/serve.sh"
    },
    "sync-proposals": {
      "description": "Sync on-chain governance proposals from RPC",
      "template": "python3 .github/scripts/sync_onchain_proposals.py"
    },
    "sync-pages": {
      "description": "Regenerate llms.txt and llms-full.txt",
      "template": "python3 buildtools/generate-llms.py && python3 buildtools/generate-llms-full.py"
    }
  },
  "permission": {
    "bash": {
      "git*": "allow",
      "python3 *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "rm *": "ask",
      "*": "ask"
    },
    "edit": "allow"
  }
}
